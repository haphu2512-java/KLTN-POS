# ===================================================================
# POS & INVENTORY MANAGEMENT SYSTEM - BACKEND + DOCKER COMPOSE
# ===================================================================
# Sao chép file này thành '.env' (cùng thư mục gốc repo) rồi điền giá trị.
#   cp .env.example .env
# File .env đã nằm trong .gitignore, KHÔNG commit file .env lên Git.
#
# File .env này được đọc bởi:
#   - Backend Spring Boot (spring.config.import trong application.properties),
#     dù chạy từ thư mục BACKEND/ (mvn spring-boot:run) hay từ thư mục gốc.
#   - Docker Compose (docker compose up).
# Frontend dùng FRONTEND/.env, mobile dùng MOBILE/.env (xem file .env.example trong từng thư mục).
#
# Viết dạng KEY=value, không đặt dấu ngoặc kép quanh giá trị.
# Biến môi trường của hệ điều hành luôn được ưu tiên hơn giá trị trong file này.

# -------------------------------------------------------------------
# 1. DATABASE (MySQL 8.0)
# -------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pos_inventory
# Tài khoản backend dùng khi chạy trực tiếp (mvn spring-boot:run)
DB_USERNAME=root
# BẮT BUỘC
DB_PASSWORD=

# Chỉ dùng cho Docker Compose: mật khẩu root của container MySQL và user ứng dụng
# (khi chạy bằng Docker, backend kết nối bằng DB_USER / DB_PASSWORD)
DB_ROOT_PASSWORD=
DB_USER=posuser

# -------------------------------------------------------------------
# 2. BACKEND SERVER & BẢO MẬT
# -------------------------------------------------------------------
SERVER_PORT=8080

# BẮT BUỘC: khóa ký JWT (HMAC-SHA256), tối thiểu 32 ký tự. Tạo ngẫu nhiên, ví dụ:
#   openssl rand -hex 32
JWT_SECRET=

# Thời hạn token, mili giây (86400000 = 24 giờ)
JWT_EXPIRATION=86400000

# Mật khẩu cho 2 tài khoản mẫu admin và cashier, chỉ dùng khi database còn trống (lần chạy đầu).
# BẮT BUỘC ở lần chạy đầu tiên. Đổi mật khẩu trong ứng dụng sau khi đăng nhập.
SEED_DEFAULT_PASSWORD=

# Origin được phép gọi API và WebSocket (phân tách bằng dấu phẩy, hỗ trợ ký tự *)
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://192.168.*.*:*,http://10.*.*.*:*,http://172.*.*.*:*,file://*

# JPA Hibernate (update / validate / none)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# -------------------------------------------------------------------
# 3. AI DỰ BÁO NHU CẦU (xem AI_for_POS.md)
# -------------------------------------------------------------------
# EXP_SMOOTH (làm trơn hàm mũ) hoặc MOVING_AVG (trung bình trượt)
AI_FORECAST_ALGORITHM=EXP_SMOOTH
# Số ngày dự báo (7, 14 hoặc 30)
AI_DEFAULT_FORECAST_DAYS=7
# Thời gian giao hàng của nhà cung cấp L (ngày), dùng tính tồn kho an toàn và điểm đặt hàng lại
AI_LEAD_TIME_DAYS=2
# Hệ số Z của mức phục vụ (1.65 = 95%), SS = Z × σ × √L
AI_SERVICE_LEVEL_Z=1.65
# Số ngày lịch sử bán hàng dùng để dự báo
AI_HISTORY_DAYS=30

# -------------------------------------------------------------------
# 3b. CA LÀM VIỆC
# -------------------------------------------------------------------
# true: thu ngân phải mở ca (nhập tiền đầu ca) mới bán được hàng
POS_REQUIRE_OPEN_SHIFT=true

# -------------------------------------------------------------------
# 4. TRỢ LÝ AI LLM (tùy chọn, chưa dùng trong code)
# -------------------------------------------------------------------
ENABLE_AI_ASSISTANT=false
GEMINI_API_KEY=
AI_LLM_MODEL=gemini-1.5-flash

# -------------------------------------------------------------------
# ĐIỆN THOẠI QUÉT MÃ PHẢI CÙNG MẠNG VỚI MÁY POS
# -------------------------------------------------------------------
# Server so IP của điện thoại với IP của máy POS đang kết nối quầy: trùng IP (cùng router ra Internet)
# hoặc cùng dải mạng nội bộ thì mới nhận mã. Đặt false chỉ khi thử nghiệm.
# Lưu ý Docker: máy POS chạy trên chính máy đặt container sẽ hiện IP cổng Docker (172.x), khác dải Wi-Fi
# của điện thoại nên bị chặn. Khi đó chạy backend bằng mvn spring-boot:run hoặc network_mode: host.
SCANNER_REQUIRE_SAME_NETWORK=true
# Dải mạng LAN của cửa hàng: 24 nghĩa là 192.168.1.x; mạng lớn hơn (vd. 10.0.x.x) thì đặt 16
SCANNER_LAN_IPV4_PREFIX=24
# Chỉ đặt true khi backend đứng sau reverse proxy tin cậy (nginx...) có ghi X-Forwarded-For
SCANNER_TRUST_FORWARDED_FOR=false
