# ===================================================================
# POS & INVENTORY MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ===================================================================
# Copy this file to '.env' and adjust values for your environment.
# DO NOT commit real secrets or production .env to version control!

# -------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL 8.0)
# -------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pos_inventory
DB_USERNAME=root
DB_PASSWORD=123456

# For Docker Compose setup only
DB_ROOT_PASSWORD=root
DB_USER=posuser

# -------------------------------------------------------------------
# 2. BACKEND SERVER & SECURITY (Spring Boot 3)
# -------------------------------------------------------------------
SERVER_PORT=8080

# 256-bit Secret Key for HMAC-SHA256 JWT Signing
# Generate a fresh 64-character hex/base64 key in production:
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Token Expiration in milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,file://*

# JPA Hibernate Mode (update / validate / none)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# -------------------------------------------------------------------
# 3. FRONTEND & ELECTRON CLIENT (Vite + React)
# -------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080/ws
VITE_APP_TITLE=POS & Quản Lý Kho Bán Lẻ

# -------------------------------------------------------------------
# 4. AI DEMAND FORECASTING (Core Time-Series Forecasting)
# Refer to AI_for_POS.md: Time Series Forecasting for Small Retail
# -------------------------------------------------------------------
# Default forecasting algorithm: EXP_SMOOTH (Exponential Smoothing) or MOVING_AVG (Moving Average)
AI_FORECAST_ALGORITHM=EXP_SMOOTH

# Forecast horizon in days (7, 14, or 30 days)
AI_DEFAULT_FORECAST_DAYS=7

# Safety stock multiplier factor (1.10 = 10% safety buffer for lead time uncertainty)
AI_SAFETY_STOCK_FACTOR=1.10

# Supplier Lead Time in days for Reorder Point calculation (ROP = D_avg * L + SS)
AI_LEAD_TIME_DAYS=3

# -------------------------------------------------------------------
# 5. AI LLM ASSISTANT (Optional - Chatbot & Report Summarization)
# Refer to AI_for_POS.md Section 4 & 5
# -------------------------------------------------------------------
ENABLE_AI_ASSISTANT=false
GEMINI_API_KEY=your_gemini_api_key_here
AI_LLM_MODEL=gemini-1.5-flash
