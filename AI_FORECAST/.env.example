# Nguồn dữ liệu: csv (mặc định, đọc sample_data/) hoặc mysql
FORECAST_DATA_SOURCE=csv
FORECAST_DATA_DIR=./sample_data

# Khi FORECAST_DATA_SOURCE=mysql (cùng biến với docker-compose ở thư mục gốc)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pos_inventory
DB_USERNAME=posuser
DB_PASSWORD=

# Tham số mô hình (AI_for_POS.md mục 3)
AI_FORECAST_ALGORITHM=EXP_SMOOTH
AI_FORECAST_ALPHA=0.35
AI_FORECAST_MA_WINDOW=7
AI_FORECAST_Z=1.65
AI_LEAD_TIME_DAYS=2
AI_REVIEW_PERIOD_DAYS=7
AI_HISTORY_DAYS=30
AI_VALIDATION_DAYS=7
AI_INTERMITTENT_ZERO_RATIO=0.5
