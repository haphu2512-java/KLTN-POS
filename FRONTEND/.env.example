# ===================================================================
# FRONTEND / ELECTRON CLIENT
# ===================================================================
# Sao chép thành FRONTEND/.env:  cp .env.example .env
# Lưu ý: mọi biến VITE_* được nhúng vào bundle JS, ai mở ứng dụng cũng đọc được.
# Không đặt bí mật thật vào đây.

# --- Chạy dev (npm run dev) ---
# Cổng của Vite dev server
DEV_SERVER_PORT=5173
# Địa chỉ backend mà Vite proxy chuyển tiếp /api và /ws tới
DEV_PROXY_TARGET=http://localhost:8080

# --- Địa chỉ API và WebSocket ---
# Để trống khi chạy dev: dùng /api và /ws cùng origin, đi qua proxy ở trên.
# BẮT BUỘC khi build Electron (npm run electron:build), vì app chạy qua file:// không có proxy:
#   VITE_API_BASE_URL=http://<IP_MAY_CHU>:8080/api
#   VITE_WS_URL=ws://<IP_MAY_CHU>:8080/ws
VITE_API_BASE_URL=
VITE_WS_URL=

# Tiêu đề ứng dụng
VITE_APP_TITLE=POS & Quản Lý Kho Bán Lẻ

# Mật khẩu điền sẵn ở màn hình đăng nhập cho tài khoản mẫu (chỉ dùng khi demo).
# Để trống ở môi trường thật.
VITE_DEMO_PASSWORD=
