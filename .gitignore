.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Exception: Keep .env.example templates committed
!.env.example
!FRONTEND/.env.example
!MOBILE/.env.example

# --- Java & Spring Boot (BACKEND) ---
BACKEND/target/
target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar

# --- Node.js & React / Vite / Electron (FRONTEND) ---
FRONTEND/node_modules/
node_modules/
FRONTEND/dist/
FRONTEND/dist-ssr/
dist/
dist-ssr/
.npm
*.tsbuildinfo

# --- Python & AI / Forecasting artifacts ---
