# ===================================================================
# MOBILE BARCODE SCANNER ENVIRONMENT CONFIGURATION (.env)
# ===================================================================
# Biến môi trường cho Expo ứng dụng quét mã vạch (tiền tố EXPO_PUBLIC_)
# 
# 1. Điện thoại thật (kết nối Wi-Fi cùng máy tính):
#    EXPO_PUBLIC_SERVER_URL=http://<IP_WIFI_MAY_TINH>:8080 (VD: http://192.168.100.53:8080)
#
# 2. Máy ảo Android Studio Emulator:
#    EXPO_PUBLIC_SERVER_URL=http://10.0.2.2:8080
#
# 3. Trình duyệt Web / Localhost:
#    EXPO_PUBLIC_SERVER_URL=http://localhost:8080

EXPO_PUBLIC_SERVER_URL=http://192.168.100.53:8080
