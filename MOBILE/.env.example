# ===================================================================
# MOBILE BARCODE SCANNER (Expo)
# ===================================================================
# Sao chép thành MOBILE/.env:  cp .env.example .env
# Biến có tiền tố EXPO_PUBLIC_ được nhúng vào app, không đặt bí mật vào đây.
#
# Địa chỉ server mặc định (người dùng vẫn sửa được trong màn hình Cài đặt của app):
# 1. Điện thoại thật (cùng Wi-Fi với máy chạy backend):
#    EXPO_PUBLIC_SERVER_URL=http://<IP_WIFI_MAY_TINH>:8080
# 2. Máy ảo Android Studio:
#    EXPO_PUBLIC_SERVER_URL=http://10.0.2.2:8080
# 3. Trình duyệt web / iOS Simulator:
#    EXPO_PUBLIC_SERVER_URL=http://localhost:8080

EXPO_PUBLIC_SERVER_URL=
